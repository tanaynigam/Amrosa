rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared / seeded recipes ─────────────────────────────────────────────
    // Read-only for any authenticated user.
    // Only writable via Firebase Admin SDK (backend scripts, Cloud Functions).
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Personal recipes ────────────────────────────────────────────────────
    // Each user's recipes at personal_recipes/{uid}/recipes/{recipeId}.
    // Only the owner can read or write.
    match /personal_recipes/{uid}/recipes/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Shared recipes (visibility tiers) ───────────────────────────────────
    // The recipe's `visibility` field gates reads:
    //   "public"  → readable by anyone (web + app), even unauthenticated.
    //   "friends" → readable only by the author and accepted co-chefs
    //               (a mutual-follow doc {viewer}_{author} with status "accepted").
    //   (private recipes are never mirrored here.)
    // Only the recipe's author can create, update, or delete.
    match /shared_recipes/{recipeId} {
      allow read: if resource.data.visibility == 'public'
        || (request.auth != null && request.auth.uid == resource.data.authorId)
        // "shared" tier: per-recipient ACL — readable only by the listed UIDs.
        || (request.auth != null && request.auth.uid in resource.data.get('sharedWith', []))
        || (request.auth != null && resource.data.visibility == 'friends'
            && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + resource.data.authorId))
            && get(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + resource.data.authorId)).data.status == 'accepted');

      // Only the author may write, and ONLY shared tiers may exist here — a doc with
      // visibility 'private' (or anything else) is rejected, so a private recipe can never be
      // mirrored. "shared" docs are gated by the sharedWith ACL in the read rule above.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authorId
        && request.resource.data.visibility in ['shared', 'friends', 'public'];

      allow update: if request.auth != null
        && request.auth.uid == resource.data.authorId
        && request.resource.data.visibility in ['shared', 'friends', 'public'];

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorId;

      // ── Notes (community thread; stored in the `comments` subcollection) ──────
      match /comments/{commentId} {
        allow read: if request.auth != null;

        // Anyone who can read the recipe may add a note, UNLESS the author locked the thread
        // (notesLocked on the parent doc; defaults false).
        allow create: if request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.uid == request.resource.data.authorId
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && get(/databases/$(database)/documents/shared_recipes/$(recipeId)).data.get('notesLocked', false) == false;

        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == get(/databases/$(database)/documents/shared_recipes/$(recipeId)).data.authorId
        );

        allow update: if false; // comments are immutable once posted
      }

      // ── Likes ─────────────────────────────────────────────────────────────
      // Presence of likes/{uid} = that user liked the recipe. likeCount on the parent
      // doc is maintained by Cloud Functions (Admin SDK). Each user manages only their own like.
      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // ── Public user profiles ────────────────────────────────────────────────
    // Readable by any signed-in user (for search + follow).
    // Only the profile owner can write their own document.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Private subdocs (e.g. push/fcmToken) — readable only by the owner.
      // Cloud Functions read these via the Admin SDK, which bypasses rules.
      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Follow relationships ────────────────────────────────────────────────
    // Document ID = {followerId}_{followeeId}.
    //
    // Create: the followerId field must match the requester's UID.
    // Update: only the followee can update (to accept/reject).
    // Delete: either party can remove the follow.
    //
    // Required composite indexes (create via Firestore console or the emitted error URL):
    //   Collection: follows  Fields: followeeId ASC, status ASC
    //   Collection: follows  Fields: followerId ASC, status ASC
    match /follows/{followId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.followerId
            || request.auth.uid == resource.data.followeeId);

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.followerId;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.followeeId;

      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.followerId
            || request.auth.uid == resource.data.followeeId);
    }

    // ── Per-user notification inbox ─────────────────────────────────────────
    // Only the inbox owner can read or mark-as-read their own items.
    // Any signed-in user may write a notification TO someone else.
    //   (delivery = write to someone else's inbox)
    match /notifications/{uid}/items/{notifId} {
      allow read, update: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.type in ['follow_request', 'follow_accepted', 'recipe_shared'];

      allow delete: if false; // notifications are never deleted by the client
    }

    // ── Directly shared recipes ─────────────────────────────────────────────
    // A recipe shared privately to a specific user.
    // Sender can create; recipient can read.
    match /shared_to/{recipientUid}/recipes/{shareId} {
      allow read: if request.auth != null && request.auth.uid == recipientUid;

      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.fromUid == request.auth.uid;

      // Recipient may delete their own pending pointer (consume on save, or dismiss).
      allow delete: if request.auth != null && request.auth.uid == recipientUid;
      allow update: if false; // pointers are never edited in place
    }

    // ── Received-recipe references (Tab 2) ──────────────────────────────────
    // Pointers a user saved to other authors' public recipes.
    // received_recipes/{uid}/items/{recipeId} = { authorUid, authorName, recipeId, savedAt }.
    // Fully owned by the user: they read/create/delete their own references.
    // The actual recipe data is read from the public shared_recipes/{recipeId} mirror.
    match /received_recipes/{uid}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Deny everything else ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
