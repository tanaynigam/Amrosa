rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared / seeded recipes ─────────────────────────────────────────────
    // Read-only for any authenticated user (anonymous or named).
    // Only writable via the Firebase Admin SDK (backend scripts, Cloud Functions).
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Personal recipes ────────────────────────────────────────────────────
    // Each user's recipes live at personal_recipes/{uid}/recipes/{recipeId}.
    // Only the owner can read or write their own subcollection.
    match /personal_recipes/{uid}/recipes/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Deny everything else ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
