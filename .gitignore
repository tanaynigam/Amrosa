*.iml
.gradle
.DS_Store
.externalNativeBuild
.cxx

# Android — local machine config (never commit)
android/local.properties
android/.gradle/
android/.kotlin/

# Android — IDE files
android/.idea/caches
android/.idea/libraries
android/.idea/modules.xml
android/.idea/workspace.xml
android/.idea/navEditor.xml
android/.idea/assetWizardSettings.xml

# Android — build output
android/app/build/
android/build/

# Android — Firebase config (contains API keys)
android/app/google-services.json

# iOS — machine-specific and build output
ios/.build/
ios/Pods/
ios/*.xcworkspace/xcuserdata/
ios/DerivedData/
ios/Amrosa/GoogleService-Info.plist

# Backend — Firebase service account key (secret — never commit)
backend/firestore/serviceAccountKey.json
backend/firestore/node_modules/

# Backend — Cloud Functions
backend/functions/node_modules/
backend/functions/.env
