    <path android:strokeColor="#000000" android:strokeWidth="6" android:strokeLineCap="round" android:pathData="M171,324.75L171,333.75" />
    <path android:strokeColor="#000000" android:strokeWidth="6" android:strokeLineCap="round" android:pathData="M179.25,324.75L179.25,333.75" />
    <path android:strokeColor="#000000" android:strokeWidth="6" android:strokeLineCap="round" android:pathData="M187.5,324.75L187.5,333.75" />
